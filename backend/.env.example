# Copy this file to backend/.env and set your own values.

# Server
PORT=5000
NODE_ENV=development

# Database
MONGODB_URI=mongodb://localhost:27017/kanbantask

# Authentication: set a long random string, for example from "openssl rand -hex 32"
JWT_SECRET=change-me
JWT_EXPIRES_IN=7d

# Frontend
FRONTEND_URL=http://localhost:3000

# File upload
UPLOAD_PATH=./uploads
MAX_FILE_SIZE=5242880
